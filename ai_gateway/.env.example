NEWAPI_BASE_URL=https://your-newapi.example/v1
NEWAPI_API_KEY=sk-xxxxxxxx
NEWAPI_MODEL=pymcl-assistant
NEWAPI_DEGRADE_MODEL=pymcl-assistant
# 客户端可切换的模型白名单（逗号分隔），给「深度诊断」档用；留空则只允许默认模型
NEWAPI_ALLOWED_MODELS=
BIND=0.0.0.0
PORT=8787
RATE_PER_MIN=40
RATE_PER_DAY=800
MAX_INFLIGHT=4
# 单次回复 token 上限（诊断类长报告建议 >= 6144）
MAX_TOKENS_CAP=8192
