# PyMCL 反馈中心配置示例。复制为 .env 后按需修改。

# 上报口：启动器 POST /api/v1/feedback|/heartbeat 打这里，做内网穿透的是它
INGEST_BIND=0.0.0.0
INGEST_PORT=18788

# 看板口：只给开发者自己，别穿透出去
UI_BIND=0.0.0.0
UI_PORT=18789

# 看板管理令牌。留空会自动生成并写入 data/admin_token.txt（推荐）。
# 显式设 NO_ADMIN_TOKEN=1 才允许无鉴权看板（不建议）。
#ADMIN_TOKEN=

# 上报口限流（按 IP）
RATE_PER_MIN=30
RATE_PER_DAY=400

# 机器在线判定（秒）与离线机器保留天数（超过后清理磁盘记录）
MACHINE_TTL=90
MACHINE_KEEP_DAYS=30

# 反馈保留条数（feedback.jsonl 超过 2 倍自动压缩）与日志上限（MB）
KEEP_FEEDBACK=5000
LOG_MAX_MB=20

# VERBOSE=1 记录全部请求日志（默认只记 4xx/5xx）
#VERBOSE=1
